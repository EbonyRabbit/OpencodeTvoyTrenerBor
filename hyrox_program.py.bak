def create_workbook():
    wb = Workbook()
    wb.remove(wb.active)

    # ==============================
    # OVERVIEW SHEET
    # ==============================
    overview = wb.create_sheet("HYROX программа 12 нед")
    overview.merge_cells("A1:H1")
    style_title(overview, "A1", "HYROX: 12-недельная программа подготовки")

    info = [
        ("Цель", "Успешное прохождение HYROX (8 км + 8 станций)"),
        ("Формат", "3 тренировки в неделю"),
        ("Структура недели", "1) Сила/гипертрофия — 2) Интервальная работа/AMRAP — 3) Бег на выносливость"),
        ("Периодизация", "Фаза 1 (нед 1-4): Фундамент — Фаза 2 (нед 5-8): Развитие — Фаза 3 (нед 9-12): Пик + гонка"),
        ("Разгрузка", "Недели 4 и 8: снижение объёма на 30%"),
        ("Контроль", "RPE 7-9, ЧСС Зона 2 (120-135) / Зона 3 (140-155) / Зона 4 (160-175)"),
    ]
    for i, (label, value) in enumerate(info):
        r = 3 + i
        overview.cell(r, 1, label).font = Font(bold=True)
        overview.cell(r, 1).fill = fill(LIGHT_GRAY)
        overview.cell(r, 2, value)
        overview.merge_cells(start_row=r, start_column=2, end_row=r, end_column=8)
        for c in range(1, 9):
            overview.cell(r, c).border = Border(top=thin, bottom=thin, left=thin, right=thin)
            overview.cell(r, c).alignment = Alignment(vertical="center", wrap_text=True)

    overview.merge_cells("A10:H10")
    style_title(overview, "A10", "Фаза 1: Фундамент (нед 1-4)")
    overview.merge_cells("A11:H11")
    overview.cell(11, 1, "Цель: построение аэробной базы, освоение техники Hyrox-движений, адаптация к объёму. RPE 7-8.")
    overview.cell(11, 1).fill = fill(BLUE)
    overview.cell(11, 1).alignment = Alignment(wrap_text=True, vertical="center")
    overview.cell(12, 1, "Неделя 1").font = Font(bold=True)
    overview.cell(12, 2, "Адаптация, техника, аэробная база")
    overview.merge_cells(start_row=12, start_column=2, end_row=12, end_column=8)
    overview.cell(13, 1, "Неделя 2").font = Font(bold=True)
    overview.cell(13, 2, "Увеличение объёма, RPE 7-8")
    overview.merge_cells(start_row=13, start_column=2, end_row=13, end_column=8)
    overview.cell(14, 1, "Неделя 3").font = Font(bold=True)
    overview.cell(14, 2, "Тяжёлые базовые, RPE 8, рост интервалов")
    overview.merge_cells(start_row=14, start_column=2, end_row=14, end_column=8)
    overview.cell(15, 1, "Неделя 4").font = Font(bold=True)
    overview.cell(15, 2, "Разгрузка: -30% объёма, восстановление")
    overview.merge_cells(start_row=15, start_column=2, end_row=15, end_column=8)

    overview.merge_cells("A17:H17")
    style_title(overview, "A17", "Фаза 2: Развитие (нед 5-8)")
    overview.merge_cells("A18:H18")
    overview.cell(18, 1, "Цель: увеличение интенсивности, Hyrox-специфика, пороговая работа. Появление санок, фермерской прогулки, wall ball в объёме.")
    overview.cell(18, 1).fill = fill(GREEN)
    overview.cell(18, 1).alignment = Alignment(wrap_text=True, vertical="center")
    overview.cell(19, 1, "Неделя 5").font = Font(bold=True)
    overview.cell(19, 2, "Hyrox-специфика, RPE 8")
    overview.merge_cells(start_row=19, start_column=2, end_row=19, end_column=8)
    overview.cell(20, 1, "Неделя 6").font = Font(bold=True)
    overview.cell(20, 2, "Рост интенсивности, сложные сеты")
    overview.merge_cells(start_row=20, start_column=2, end_row=20, end_column=8)
    overview.cell(21, 1, "Неделя 7").font = Font(bold=True)
    overview.cell(21, 2, "Пиковая нагрузка, RPE 9")
    overview.merge_cells(start_row=21, start_column=2, end_row=21, end_column=8)
    overview.cell(22, 1, "Неделя 8").font = Font(bold=True)
    overview.cell(22, 2, "Разгрузка: восстановление перед финальным блоком")
    overview.merge_cells(start_row=22, start_column=2, end_row=22, end_column=8)

    overview.merge_cells("A24:H24")
    style_title(overview, "A24", "Фаза 3: Пик и гонка (нед 9-12)")
    overview.merge_cells("A25:H25")
    overview.cell(25, 1, "Цель: полная имитация Hyrox, гоночный темп, подвод к старту.")
    overview.cell(25, 1).fill = fill(YELLOW)
    overview.cell(25, 1).alignment = Alignment(wrap_text=True, vertical="center")
    overview.cell(26, 1, "Неделя 9").font = Font(bold=True)
    overview.cell(26, 2, "Специфическая подготовка, имитация")
    overview.merge_cells(start_row=26, start_column=2, end_row=26, end_column=8)
    overview.cell(27, 1, "Неделя 10").font = Font(bold=True)
    overview.cell(27, 2, "Пиковая специфическая работа")
    overview.merge_cells(start_row=27, start_column=2, end_row=27, end_column=8)
    overview.cell(28, 1, "Неделя 11").font = Font(bold=True)
    overview.cell(28, 2, "Предгоночная разгрузка")
    overview.merge_cells(start_row=28, start_column=2, end_row=28, end_column=8)
    overview.cell(29, 1, "Неделя 12").font = Font(bold=True)
    overview.cell(29, 2, "ГОНОЧНАЯ НЕДЕЛЯ: HYROX")
    overview.merge_cells(start_row=29, start_column=2, end_row=29, end_column=8)

    widths_ov = [25, 60, 12, 12, 12, 12, 12, 12]
    for i, w in enumerate(widths_ov, 1):
        overview.column_dimensions[get_column_letter(i)].width = w
    set_common(overview)

    # ==============================
    # WEEKLY SHEETS
    # ==============================
    for week_num in range(1, 13):
        data = WEEKLY_DATA[week_num]
        ws = wb.create_sheet(f"Неделя {week_num}")
        ws.merge_cells("A1:G1")
        style_title(ws, "A1", f"Неделя {week_num}: {data['focus']}")
        ws.row_dimensions[1].height = 28

        row = 3
        for day_key in ["strength", "intervals", "run"]:
            day = data[day_key]
            ws.merge_cells(f"A{row}:G{row}")
            ws[f"A{row}"] = day["title"]
            ws[f"A{row}"].font = Font(bold=True, size=12, color=WHITE)
            ws[f"A{row}"].fill = fill(NAVY)
            ws[f"A{row}"].alignment = Alignment(horizontal="left", vertical="center")
            ws.row_dimensions[row].height = 24
            row += 1

            ws.merge_cells(f"A{row}:G{row}")
            ws[f"A{row}"] = "🎯 " + day["goal"]
            ws[f"A{row}"].fill = fill(LIGHT_GRAY)
            ws[f"A{row}"].alignment = Alignment(wrap_text=True, vertical="center")
            row += 1

            headers = ["Блок", "Упражнение", "Подходы", "Повторы", "Вес/Интенсивность", "RPE/ЧСС", "Заметки"]
            for c, h in enumerate(headers, 1):
                ws.cell(row, c, h)
            style_header(ws, row, 1, len(headers))
            r0 = row
            row += 1

            for ex in day["exercises"]:
                for c, val in enumerate(ex, 1):
                    if c <= len(headers):
                        ws.cell(row, c, val)
                row += 1

            # Color blocks
            for r in range(r0 + 1, row):
                section = str(ws.cell(r, 1).value or "")
                if section in ("Разминка", "Заминка"):
                    for c in range(1, 8):
                        ws.cell(r, c).fill = fill(LIGHT_BLUE)
                elif section in ("Основной блок", "Гонка", "Комплекс"):
                    for c in range(1, 8):
                        ws.cell(r, c).fill = fill(BLUE)

            ws.merge_cells(start_row=r0, start_column=8, end_row=row - 1, end_column=8)
            ws.cell(r0, 8).value = "Выполнение"
            ws.cell(r0, 8).alignment = Alignment(horizontal="center", vertical="center", wrap_text=True, text_rotation=90)

            row += 1  # blank row between days

        widths = [16, 36, 12, 14, 20, 16, 32, 10]
        for i, w in enumerate(widths, 1):
            ws.column_dimensions[get_column_letter(i)].width = w
        set_common(ws)

    # ==============================
    # FOOTER / INFO
    # ==============================
    info_sheet = wb.create_sheet("Примечания")
    info_sheet.merge_cells("A1:C1")
    style_title(info_sheet, "A1", "Примечания к программе")
    notes = [
        ("RPE", "Rating of Perceived Exertion (1-10). 7 = умеренно тяжело, 9 = очень тяжело."),
        ("Зоны ЧСС", "Зона 2 (120-135): разговорный темп, носовое дыхание.  Зона 3 (140-155): умеренно, можно говорить фразами.  Зона 4 (160-175): тяжело, только короткие фразы."),
        ("AMRAP", "As Many Rounds As Possible — максимум раундов за отведённое время."),
        ("EMOM", "Every Minute On the Minute — каждую минуту выполнять заданный объём, оставшееся время отдых."),
        ("Разгрузка", "Недели 4 и 8 — снижение объёма на 30%, сохранение техники. Это обязательное условие прогресса."),
        ("Бег", "Весь бег в Зоне 2 (кроме ускорений и темповой работы). Контроль пульса — приоритет."),
        ("Питание", "За 2-3 часа до тренировки: углеводы + белок. После тренировки: белок + углеводы в течение часа."),
        ("Гидратация", "В день тренировки: 2-3 л воды. В день гонки: isotonic напиток + вода."),
        ("Сон", "Минимум 7.5-8 часов. Это главный фактор восстановления."),
        ("Прогрессия", "Если все подходы выполнены в верхней границе повторов при RPE <= 8 — добавлять 2.5-5% веса."),
        ("Гонка", "HYROX: 8 км бега (8×1 км) + 8 функциональных станций. Стратегия: ровный темп на беге, мощно на станциях."),
    ]
    for i, (title, text) in enumerate(notes, 3):
        info_sheet.cell(i, 1, title).font = Font(bold=True)
        info_sheet.cell(i, 1).fill = fill(LIGHT_GRAY)
        info_sheet.cell(i, 2, text)
        info_sheet.merge_cells(start_row=i, start_column=2, end_row=i, end_column=3)
        for c in range(1, 4):
            info_sheet.cell(i, c).border = Border(top=thin, bottom=thin, left=thin, right=thin)
            info_sheet.cell(i, c).alignment = Alignment(vertical="center", wrap_text=True)
    info_sheet.column_dimensions["A"].width = 20
    info_sheet.column_dimensions["B"].width = 50
    info_sheet.column_dimensions["C"].width = 50
    set_common(info_sheet)

    wb.save(OUTPUT_FILE)
    print(f"Saved: {OUTPUT_FILE}")


if __name__ == "__main__":
    create_workbook()
